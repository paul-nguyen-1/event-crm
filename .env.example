# Used by docker-compose.yml to configure local Postgres/RabbitMQ/Redis containers
POSTGRES_IMAGE="postgres:16"
RABBITMQ_IMAGE="rabbitmq:3-management"
REDIS_IMAGE="redis:7-alpine"
POSTGRES_USER="eventcrm"
POSTGRES_PASSWORD="eventcrm"
POSTGRES_DB="eventcrm"
POSTGRES_PORT="5432"
RABBITMQ_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"
REDIS_PORT="6379"

# Used by the api service — must match the values above
DATABASE_URL="postgresql://eventcrm:eventcrm@localhost:5432/eventcrm"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# Resend (transactional email) — get a key at https://resend.com/api-keys;
# RESEND_FROM_EMAIL must be an address on a domain verified in that account
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Amazon Associates tracking ID — appended server-side to every outbound
# product link; never accepted from the client. Get one at affiliate-program.amazon.com
AMAZON_ASSOCIATES_TRACKING_ID=""

# notification-service (Go) needs RABBITMQ_URL and REDIS_URL above, plus its
# own copy of JWT_ACCESS_SECRET — must be the exact same value the api signs
# with (intentionally shared secret, not a new one to manage) — and
# WEB_ORIGIN, the frontend's full origin, required to accept cross-origin
# WebSocket/SSE connections from the browser
WEB_ORIGIN="http://localhost:5173"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# Where the api redirects the browser after a Google OAuth callback
FRONTEND_URL="http://localhost:5173"

# The api's own public base URL — used to build links (e.g. the reminder
# email's one-click unsubscribe link) that point back at the api itself
API_URL="http://localhost:3000/v1"
