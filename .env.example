# Used by docker-compose.yml to configure local Postgres/RabbitMQ containers
POSTGRES_IMAGE="postgres:16"
RABBITMQ_IMAGE="rabbitmq:3-management"
POSTGRES_USER="eventcrm"
POSTGRES_PASSWORD="eventcrm"
POSTGRES_DB="eventcrm"
POSTGRES_PORT="5432"
RABBITMQ_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"

# Used by the api service — must match the values above
DATABASE_URL="postgresql://eventcrm:eventcrm@localhost:5432/eventcrm"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"
